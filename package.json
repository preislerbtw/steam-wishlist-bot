{
  "name": "gamedeals-bot",
  "version": "1.0.0",
  "description": "Bot que monitora promoções de jogos na Steam e notifica via Telegram",
  "main": "dist/index.js",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test src/**/*.test.ts",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "monitor": "node dist/jobs/run-monitor.js",
    "monitor:dev": "tsx src/jobs/run-monitor.ts",
    "cli": "tsx src/cli.ts",
    "telegram:chat-id": "tsx src/scripts/get-chat-id.ts"
  },
  "license": "ISC",
  "dependencies": {
    "axios": "^1.21.0",
    "dotenv": "^18.0.9",
    "mongoose": "^9.11.4",
    "node-cron": "^4.6.0",
    "node-telegram-bot-api": "^2.1.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
